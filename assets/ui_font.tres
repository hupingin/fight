[gd_resource type="SystemFont" format=3]

[resource]
font_names = PackedStringArray("Microsoft YaHei UI", "Microsoft YaHei", "Yu Gothic UI", "Meiryo", "MS Gothic", "PingFang SC", "Hiragino Sans", "Noto Sans CJK SC", "Noto Sans CJK JP", "Segoe UI", "Tahoma", "Arial", "sans-serif")
font_weight = 500
antialiasing = 1
subpixel_positioning = 1
allow_system_fallback = true
